			"name": "Salvo Cortesiano",
			"email": "support@netshadows.de",
			"homepage": "https://netshadows.de",
			"role": "Lead Developer"
		},
		{
			"name": "HiFiKabin & ctrstudio",
			"homepage": "https://phpbb.hifikabin.me.uk",
			"role": "Original idea (Timezone Clock)"
		}
	],
	"require": {
		"php": ">=7.4.0",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Timezone Clock",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
	}
